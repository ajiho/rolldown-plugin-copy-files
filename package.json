{
  "name": "rolldown-plugin-copy-files",
  "version": "0.3.0",
  "description": "File copy plugin for Rolldown.",
  "keywords": [
    "build-plugin",
    "copy",
    "copy-assets",
    "copy-files",
    "glob",
    "rolldown",
    "rolldown-plugin",
    "rollup",
    "rollup-plugin",
    "static-assets"
  ],
  "bugs": {
    "url": "https://github.com/ajiho/rolldown-plugin-copy-files/issues"
  },
  "license": "MIT",
  "author": "ajiho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajiho/rolldown-plugin-copy-files.git"
  },
  "funding": "https://www.lujiahao.com/sponsor",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "tag": "latest"
  },
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "size": "size-limit",
    "build:clean": "rimraf dist",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build": "run-s build:* size",
    "test": "vitest --coverage",
    "test:ui": "pnpm run test --ui",
    "coverage": "vitest run --coverage",
    "prepare": "simple-git-hooks",
    "publint": "publint",
    "typecheck": "tsc --noEmit",
    "commitlint": "commitlint -e -V",
    "check": "run-s fmt:check lint typecheck coverage build publint",
    "release": "releaseasy"
  },
  "dependencies": {
    "native-copyfiles": "^2.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.88.0",
    "publint": "^0.3.25",
    "releaseasy": "^0.1.1",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^14.2.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "rolldown": "^1.2.0"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm commitlint",
    "pre-commit": "pnpm check"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.17.0 || ^24.18.0 || >=26.3.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^22.17.0 || ^24.18.0 || >=26.3.0"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
