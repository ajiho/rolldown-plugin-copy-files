{
  "name": "rolldown-plugin-copy-files",
  "version": "0.0.0",
  "description": "File copy plugin for Rolldown.",
  "keywords": [
    "build-plugin",
    "copy",
    "copy-assets",
    "copy-files",
    "glob",
    "rolldown",
    "rolldown-plugin",
    "rollup",
    "rollup-plugin",
    "static-assets"
  ],
  "bugs": {
    "url": "https://github.com/ajiho/rolldown-plugin-copy-files/issues"
  },
  "license": "MIT",
  "author": "ajiho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajiho/rolldown-plugin-copy-files.git"
  },
  "funding": "https://www.lujiahao.com/sponsor",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "size": "size-limit",
    "clean": "rimraf dist",
    "rolldown": "rolldown -c",
    "build": "run-s clean rolldown size",
    "test": "vitest run --coverage --ui",
    "coverage": "vitest run --coverage",
    "prepare": "simple-git-hooks",
    "publint": "publint",
    "check": "run-s lint coverage build publint"
  },
  "devDependencies": {
    "@size-limit/file": "^13.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "native-copyfiles": "2.0.3",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.78.0",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.3",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^13.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "rolldown": "^1.2.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
